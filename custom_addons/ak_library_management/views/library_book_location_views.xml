<odoo>
    <!--book location list view-->
    <record id="library_book_location_view_list" model="ir.ui.view">
            <field name="name">library.book.location.list.view</field>
            <field name="model">library.book.location</field>
            <field name="arch" type="xml">
                <list string="Books Location">
                        <field name="name"/>
                        <field name="location"/>
                        <field name="capacity" />
                        <field name="notes"/>
                </list>
            </field>
    </record>

    <!--book location form view-->
    <record id="library_book_location_view_form" model="ir.ui.view">
            <field name="name">library.book.location.form.view</field>
            <field name="model">library.book.location</field>
            <field name="arch" type="xml">
                <form string="Books Location">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" icon="fa-book" type="object" name="action_borrowed_book">
                                <field string="Books Borrowed" name="count_borrowed_book" widget="statinfo"/>
                            </button>
                        </div>
                        <group>
                            <field name="name"/>
                            <field name="location"/>
                            <field name="capacity" />
                            <field name="notes" />
                        </group>
                        <notebook>
                            <page string="Books">
                                <field name="book_ids" options="{'create': false}"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
    </record>

    <!-- book location action-->
    <record id="action_library_book_location_list" model="ir.actions.act_window">
       <field name="name">Library</field>
       <field name="res_model">library.book.location</field>
       <field name="view_mode">list,form</field>
       <field name="view_id" ref="library_book_location_view_list"/>
       <field name="help" type="html">
           <p class="o_view_nocontent_smiling_face">
               Generate library Details
           </p>
       </field>
    </record>

    <!--libraries menu-->
    <menuitem id="library_books_location_menu" name="Libraries" parent="menu_library" action="action_library_book_location_list"/>
</odoo>
