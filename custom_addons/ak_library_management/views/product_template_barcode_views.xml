<odoo>
    <!--move barcode field from general information tab to book details tab-->
    <record id="product_template_barcode_inherit_form_view" model="ir.ui.view">
        <field name="name">product.template.inherit.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="ak_library_management.product_template_form_view_inherit_lms"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='publisher']" position="after">
                <field name="barcode" position="move" required="sale_ok"/>
            </xpath>
        </field>
    </record>
</odoo>
