<odoo>
    <!--kanban style contact page-->
    <template id="contact_kanban_template" name="Contacts">
        <t t-call="website.layout">
            <div class="contacts_page">
                <div class="container">
                    <div class="row mt-2 mb-2">
                        <t t-foreach="records" t-as="record">
                            <div class="col-md-6 col-lg-4 mt-1 position-relative mb-1">
                                <div class="shadow-lg card cursor-pointer flex-row pe-5 contact-card"
                                     t-att-data-contact-slug="record.contact_slug">
                                    <t t-set="id" t-value="record.id"/>
                                    <img t-if="record.image_1920" t-att-src="image_data_uri(record.image_1920)"
                                         class="card-img-left" style="height:120px; width:120px;"
                                         loading='lazy' alt="contact image"/>
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <t t-out="record.name"/>
                                        </h5>
                                        <p class="card-text text-truncate" style="font-size:12px">
                                            <t t-out="record.email"/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!--contact detail form page-->
    <template id="contact_detail_form_template" name="Contact Detail">
        <t t-call="website.layout">
            <div class="oe_structure">
                <div class="container" t-if="contact">
                    <div class="shadow-lg card mb-2 mt-2">
                        <div class="card-body">
                            <form id="contact_form">
                                <div>
                                    <strong class="fs-3 mt-5">
                                        Profile
                                    </strong>
                                    <img t-if="contact.image_1920" t-att-src="image_data_uri(contact.image_1920)"
                                         class="float-md-end" style="height:80px; width:80px;"/>
                                </div>
                                <div class="row overflow-hidden" style="margin-top: 50px;">
                                    <div class="col-6 mt-2">
                                        <label for="InputEmail" class="form-label">Email</label>
                                        <span class="text-danger">*</span>
                                        <input type="email" class="form-control" name="email"
                                               id="InputEmail"
                                               placeholder="name@example.com" readonly="True"
                                               t-att-value='contact.email'/>
                                    </div>
                                    <div class="col-6 mt-2">
                                        <label for="InputName" class="form-label">Name</label>
                                        <span class="text-danger">*</span>
                                        <input type="text" class="form-control" name="name"
                                               id="InputName"
                                               placeholder="Name" readonly="True"
                                               t-att-value='contact.name'/>
                                    </div>
                                    <div class="col-12 mt-2">
                                        <label for="InputAddress" class="form-label">Address</label>
                                        <input type="textarea" class="form-control" name="name" id="InputAddress"
                                               placeholder="Address" readonly="True"
                                               t-att-value="contact.contact_address"/>
                                    </div>
                                    <div class="col-6 mt-2">
                                        <label for="InputWebsite" class="form-label">Website</label>
                                        <input type="tel" class="form-control" name="name" id="InputWebsite"
                                               placeholder="Website" readonly="True"
                                               t-att-value="contact.website"/>
                                    </div>
                                    <div class="col-6 mt-2">
                                        <label for="InputPhone" class="form-label">Phone
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input type="tel" class="form-control" name="name" id="InputPhone"
                                               placeholder="Phone" readonly="True"
                                               t-att-value="contact.phone"/>
                                    </div>
                                    <div class="col-12 mt-2">
                                        <a class="btn btn-primary mb-2 mt-2" href="/contacts" role="button">Back</a>
                                        <button class="btn btn-primary mb-2 mt-2 ms-1 btn-save" style="float: right;"
                                                type="submit" t-att-data-id="contact.id">
                                            Save
                                        </button>
                                        <button class="btn btn-primary mb-2 mt-2 ms-1 btn-edit" style="float: right;">
                                            Edit
                                        </button>
                                    </div>
                                </div>
                            </form>
                            <!--                            <table class="table table-borderless">-->
                            <!--                                <tbody>-->
                            <!--                                    <tr>-->
                            <!--                                      <td>Email: <t t-out="contact.email"/></td>-->
                            <!--                                      <td>Website: <t t-out="contact.website"/></td>-->
                            <!--                                    </tr>-->
                            <!--                                    <tr>-->
                            <!--                                       <td>Phone: <t t-out="contact.phone"/></td>-->
                            <!--                                       <td>Tax ID: <t t-out="contact.vat"/></td>-->
                            <!--                                    </tr>-->
                            <!--                                    <tr>-->
                            <!--                                       <td>Mobile: <t t-out="contact.mobile"/></td>-->
                            <!--                                       <td>Tags:-->
                            <!--                                           <t t-foreach="contact.category_id" t-as="tag">-->
                            <!--                                               <span style="border-radius: 20px;background: #B4EBE6; padding-left:10px; padding-right:10px;margin-right:5px;">-->
                            <!--                                                   <t t-out="tag.name"/>-->
                            <!--                                               </span>-->
                            <!--                                           </t>-->
                            <!--                                       </td>-->
                            <!--                                    </tr>-->
                            <!--                                  </tbody>-->
                            <!--                            </table>-->
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>