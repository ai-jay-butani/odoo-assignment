<odoo>

     <!--borrow transaction history schedule action-->
    <record id="ir_cron_borrow_transaction_history" model="ir.cron">
        <field name="name">Borrow Book Reminder</field>
        <field name="model_id" ref="model_borrow_transaction_history"/>
        <field name="state">code</field>
        <field name="code">model.reminder_borrow_book()</field>
        <field name='interval_number'>1</field>
        <field name='interval_type'>minutes</field>
    </record>

     <!--borrow transaction history change book status server action-->
    <record id="ir_actions_borrow_transaction_history" model="ir.actions.server">
        <field name="name">Change Book status</field>
        <field name="model_id" ref="model_borrow_transaction_history"/>
        <field name="binding_model_id" ref="model_borrow_transaction_history"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            for rec in records:
                for book in rec.book_ids:
                    env['bus.bus']._sendone(rec.customer_id, 'simple_notification', {
                    'type': 'warning',
                    'message': f"{rec.customer_id.name} your return book has been recorded.",
                    })
                    book.mark_as_returned()
        </field>
    </record>

    <!--borrow transaction history server action-->
    <record id="server_actions_borrow_transaction_history" model="ir.actions.server">
        <field name="name">Due Date Check</field>
        <field name="model_id" ref="model_borrow_transaction_history"/>
        <field name="state">code</field>
        <field name="code">record.automated_action()</field>
    </record>

    <!--borrow transaction history automated action-->
    <record id="automated_action_borrow_transaction_history" model="base.automation">
        <field name="name">Due Date Check</field>
        <field name="model_id" ref="model_borrow_transaction_history"/>
        <field name="trigger">on_create_or_write</field>
        <field name="action_server_ids" eval="[(4,ref('server_actions_borrow_transaction_history'))]"/>
    </record>

    <!--product template server action-->
    <record id="server_actions_product_template" model="ir.actions.server">
        <field name="name">Duplicate Name Check</field>
        <field name="model_id" ref="model_product_template"/>
        <field name="state">code</field>
        <field name="code">record._automated_action_duplicate_product_name()</field>
    </record>

    <!--product template automated action-->
    <record id="automated_action_product_template" model="base.automation">
        <field name="name">Duplicate Name Check</field>
        <field name="model_id" ref="model_product_template"/>
        <field name="trigger">on_create_or_write</field>
        <field name="action_server_ids" eval="[(4,ref('server_actions_product_template'))]"/>
    </record>
</odoo>