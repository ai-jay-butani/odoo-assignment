<odoo>
    <record id="ir_cron_borrow_transaction_history" model="ir.cron">
        <field name="name">Borrow Book Reminder</field>
        <field name="model_id" ref="model_borrow_transaction_history"/>
        <field name="state">code</field>
        <field name="code">model.reminder_borrow_book()</field>
        <field name='interval_number'>1</field>
        <field name='interval_type'>minutes</field>
    </record>

    <record id="ir_actions_borrow_transaction_history" model="ir.actions.server">
        <field name="name">Change Book status</field>
        <field name="model_id" ref="model_borrow_transaction_history"/>
        <field name="binding_model_id" ref="model_borrow_transaction_history"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            for rec in records:
                for book in rec.book_ids:
                    env['bus.bus']._sendone(rec.customer_id, 'simple_notification', {
                    'type': 'warning',
                    'message': f"{rec.customer_id.name} your return book has been recorded.",
                    })
                    book.mark_as_returned()
        </field>
    </record>
</odoo>