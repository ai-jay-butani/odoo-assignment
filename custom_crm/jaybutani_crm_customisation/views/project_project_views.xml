<odoo>
    <record id="edit_project_add_job" model="ir.ui.view">
        <field name="name">project.project.form.add.job</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="job_name" readonly="reinvoiced_sale_order_id != False"/>
            </xpath>
        </field>
    </record>

    <record id="view_project_add_job" model="ir.ui.view">
        <field name="name">project.project.list.add.job</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="job_name" readonly="reinvoiced_sale_order_id != False"/>
            </xpath>
        </field>
    </record>
</odoo>