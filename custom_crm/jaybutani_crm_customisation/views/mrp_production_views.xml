<odoo>
    <!--inherit manufacture tree view-->
    <record id="mrp_production_tree_view_add_job" model="ir.ui.view">
        <field name="name">mrp.production.list.add.job</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="job_name" readonly="origin"/>
            </xpath>
        </field>
    </record>

    <!--inherit manufacture form view-->
    <record id="mrp_production_form_view_add_job" model="ir.ui.view">
        <field name="name">mrp.production.form.add.job</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="job_name" readonly="origin"/>
            </xpath>
        </field>
    </record>
</odoo>