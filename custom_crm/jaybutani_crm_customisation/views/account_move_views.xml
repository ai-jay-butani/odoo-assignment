<odoo>
    <record id="view_out_invoice_tree_add_job" model="ir.ui.view">
        <field name="name">account.move.list.add.job</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="job_name"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_add_job" model="ir.ui.view">
        <field name="name">account.move.form.add.job</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="job_name"/>
            </xpath>
        </field>
    </record>
</odoo>