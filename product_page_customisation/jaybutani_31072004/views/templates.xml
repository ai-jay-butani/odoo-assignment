<odoo>
    <!--inherit template of website product and add review form-->
    <template id="product_custom_template_add_form" inherit_id="website_sale.product">
        <xpath expr="//section[@id='product_detail']" position="after">
            <section id="product_review_form" class="pt80 pb50">
                <div style="margin-left:90px;">
                    <form t-if="product.env.user.id != 4" id="product_review_form"
                          t-attf-action="/review/submit/#{product.id}" method="post">
                        <div name="title" class="mt-3">
                            <h3>Product Review Form</h3>
                        </div>
                        <div class="mt-2">
                            <div>
                                <input type="radio" name="rating" value="1" id="InputRating" required="True">
                                    <span class="ms-1 me-1">1 Star</span>
                                </input>
                                <input type="radio" name="rating" value="2" id="InputRating" required="True">
                                    <span class="ms-1 me-1">2 Star</span>
                                </input>
                                <input type="radio" name="rating" value="3" id="InputRating" required="True">
                                    <span class="ms-1 me-1">3 Star</span>
                                </input>
                                <input type="radio" name="rating" value="4" id="InputRating" required="True">
                                    <span class="ms-1 me-1">4 Star</span>
                                </input>
                                <input type="radio" name="rating" value="5" id="InputRating" required="True">
                                    <span class="ms-1 me-1">5 Star</span>
                                </input>
                            </div>
                        </div>
                        <div class="mt-2">
                            <div>
                                <input style="width:400px; height:100px;" type="textarea" class="form-control"
                                       name="description" id="InputDescription"
                                       placeholder="Write your review" required="True"/>
                            </div>
                        </div>
                        <div class="mt-3 mb-2">
                            <button class="btn btn-primary btn-submit" type="submit">
                                Submit
                            </button>
                        </div>
                    </form>
                    <div t-else="">
                        <div name="title" class="mt-3">
                            <h3>Product Review Form</h3>
                        </div>
                        <strong>Please <a href="/web/login/">log in</a> to submit the review
                        </strong>
                    </div>
                </div>
            </section>
            <div t-if="product.product_review_ids" id="product_review_history">
                <div style="border: dashed 1px purple; margin-left:90px; width:400px;"/>
                <div style="margin-left:90px;">
                    <div name="title" class="mt-3">
                        <h5>Previous Reviews</h5>
                    </div>
                    <t t-foreach="product.product_review_ids" t-as="review">
                        <div>
                            <span>
                                <i class="fa fa-user"/>
                                <t t-if="review.user_id" t-out="review.user_id.name"/>
                                <t t-else="" t-out="Anonymous"/>
                            </span>
                            -
                            <span>
                                <t t-foreach="int(review.rating)" t-as="star">
                                    <i class="fa text-warning fa-star"></i>
                                </t>
                            </span>
                            <br/>
                            <span>"<t t-out="review.description"/>"
                            </span>
                            <br/>
                            <span>"Submitted On:
                                <span class="ms-1"/>
                                <t t-out="review.create_date"/>"
                            </span>
                            <br/>
                            <br/>
                        </div>
                    </t>
                </div>
            </div>
        </xpath>
    </template>
</odoo>