<odoo>
    <!--product review list view-->
    <record id="product_review_view_list" model="ir.ui.view">
        <field name="name">product.review.list.view</field>
        <field name="model">product.review</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id"/>
                <field name="user_id"/>
                <field name="rating"/>
                <field name="description"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!--product review form view-->
    <record id="product_review_view_form" model="ir.ui.view">
        <field name="name">product.review.form.view</field>
        <field name="model">product.review</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="user_id"/>
                        <field name="rating"/>
                        <field name="description"/>
                        <field name="create_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- product review action-->
    <record id="action_product_review_list" model="ir.actions.act_window">
        <field name="name">Product Review</field>
        <field name="res_model">product.review</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="product_review_view_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Generate library Details
            </p>
        </field>
    </record>

    <!--menuitem in product submenu-->
    <menuitem id="product_review_menu" name="Product Review" action="action_product_review_list"
              parent="sale.product_menu_catalog" sequence="0"/>

</odoo>