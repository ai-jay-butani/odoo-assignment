<odoo>
    <!--inherit product.template form view-->
    <record id="product_template_form_view_inherit_add_boolean" model="ir.ui.view">
        <field name="name">product.template.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-flex">
                    <field name="is_out_of_stock"/>
                    <label for="is_out_of_stock"/>
                </span>
            </xpath>
            <xpath expr="//group[@name='internal_notes']" position="after">
                <group name="out_of_stock_message" string="Custom Out-of-Stock Message"
                       groups="sales_team.group_sale_manager,website.group_website_designer">
                    <field name="out_of_stock_message" colspan="2" nolabel="1" placeholder="custom out of stock message"
                           groups="sales_team.group_sale_manager,website.group_website_designer"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>