<odoo>
    <!--inherit sale order form view add buttons-->
    <record id="view_inherit_sale_order_add_button_form" model="ir.ui.view">
        <field name="name">sale.order.add.button.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm'][2]" position="attributes">
                <attribute name="invisible">approval_required or state in ['sale','cancel']</attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm'][2]" position="after">
                <button name="action_send_approve" string="send for approval" type="object" invisible="state in ['approval','sale','cancel'] or not approval_required"/>
            </xpath>
            <xpath expr="//button[@name='action_confirm'][2]" position="after">
                <button name="action_approve" string="approve" type="object"
                        invisible="not approval_required or state in ['draft', 'sent', 'sale']"
                        groups="sales_team.group_sale_manager"/>
            </xpath>
        </field>
    </record>
</odoo>