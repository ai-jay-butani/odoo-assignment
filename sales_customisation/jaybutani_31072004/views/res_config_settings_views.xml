<odoo>
    <!--add sales managers in settings-->
    <record id="res_config_settings_view_form_add_manager_field" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sales.manager.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='users_setting_container']" position="after">
                <div id="sales_manager_config">
                    <block title="Sales Managers" name="sale_managers_settings_container">
                        <setting id="sales_managers">
                            <button string="Add Managers" type="object" name="add_managers"/>
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>

</odoo>